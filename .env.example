PORT=3000
# ADMIN_KEY=change-me-to-a-strong-secret
ADMIN_KEY=rjl070318
DATA_DIR=./data
MAX_FILE_SIZE=104857600
DEFAULT_EXPIRE_HOURS=24
DEFAULT_MAX_DOWNLOADS=5
RATE_LIMIT_MISSES=10
UPLOAD_LIMIT_PER_MINUTE=10
# 上传分片大小（同时是分片体 body 上限）；片数将超 1024 时会话内自动向上翻倍
TRANSFER_PART_SIZE=4194304
# 目标分片数：每个文件会被切成约这么多片（并发 4~8 时兼顾负载均衡与请求开销）
UNIT_TARGET_COUNT=32
# 单个单元（分片）最小/最大字节数
UNIT_MIN_SIZE=262144
UNIT_MAX_SIZE=8388608
# 单文件最大单元数（超出则加大单元尺寸，保证请求数可控）
UNIT_MAX_COUNT=256
# 存储态编解码候选（按序尝试取最小）：br = brotli，gzip
COMPRESS_CODECS=br,gzip
# 每 IP 在途会话配额（超出 429；带 uploadId 的续传不占新名额）
MAX_UPLOAD_SESSIONS_PER_IP=8
MAX_DOWNLOAD_SESSIONS_PER_IP=32
# 每 IP 待处理上传的声明总大小上限（字节）
MAX_TMP_BYTES_PER_IP=536870912
# 公告预设数量硬上限（同时是站点设置「公告预设上限」的可调范围上界，默认生效值 10）
MAX_NOTICE_PRESETS=50
# 公告条数上限（多公告，默认 20；配合 priority/startAt/endAt 做定时投放）
MAX_NOTICES=20
# 传输记账追加日志（WAL）：on = 崩溃零丢失（多一次追加写），off = 保留「最多丢一个刷盘窗口」
STATS_WAL=off
# 跨文件去重（内容寻址对象存储）：默认 off；on = 新上传写清单化容器（data/objects/ + meta 清单）
CROSS_FILE_DEDUP=off
# 无引用对象的回收宽限期（毫秒，保护「对象已写、清单未落盘」等窗口）与回收周期（毫秒）
DEDUP_GC_GRACE_MS=3600000
DEDUP_GC_INTERVAL_MS=21600000
